generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuidOssp(map: "uuid-ossp"), pgTrgm(map: "pg_trgm")]
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum AuthProvider {
  APPLE
  PHONE
  EMAIL
}

enum DeviceType {
  IOS
  ANDROID
  WEB
}

enum IncidentStatus {
  PENDING
  VERIFIED
  RESOLVED
  REJECTED
  EXPIRED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ModerationContentType {
  INCIDENT
  COMMENT
  MEDIA
  USER
}

enum ModerationReason {
  NEW_CONTENT
  REPORTED
  AUTO_FLAGGED
  AI_FLAGGED
}

enum ModerationQueueStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum ReportReason {
  SPAM
  HARASSMENT
  FALSE_INFO
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  ACTION_TAKEN
  DISMISSED
}

enum VoteType {
  UPVOTE
  DOWNVOTE
  VERIFY
}

enum NotificationType {
  NEARBY_INCIDENT
  COMMENT
  UPDATE
  VERIFICATION
  SYSTEM
}

enum UpdateType {
  STATUS_CHANGE
  INFO_UPDATE
  RESOLUTION
}

enum ReputationAction {
  INCIDENT_CREATED
  INCIDENT_VERIFIED
  INCIDENT_REJECTED
  UPVOTE_RECEIVED
  DOWNVOTE_RECEIVED
  VERIFY_RECEIVED
  COMMENT_UPVOTED
  REPORT_ACCEPTED
  REPORT_REJECTED
  BAN_PENALTY
  ADMIN_ADJUSTMENT
}

// ============================================================================
// MODELS
// ============================================================================

model User {
  id                   String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  // Apple Sign-in fields
  appleId              String?      @unique @map("apple_id") @db.VarChar(255)
  appleEmail           String?      @map("apple_email") @db.VarChar(255)
  appleRefreshToken    String?      @map("apple_refresh_token")

  // Standard auth fields
  phoneNumber          String?      @unique @map("phone_number") @db.VarChar(20)
  phoneVerified        Boolean      @default(false) @map("phone_verified")
  email                String?      @unique @db.VarChar(255)
  emailVerified        Boolean      @default(false) @map("email_verified")
  authProvider         AuthProvider @default(APPLE) @map("auth_provider")

  // Profile fields
  username             String?      @unique @db.VarChar(50)
  displayName          String?      @map("display_name") @db.VarChar(100)
  avatarUrl            String?      @map("avatar_url")

  // Role and permissions
  role                 UserRole     @default(USER)

  // Reputation system
  reputationScore      Int          @default(0) @map("reputation_score")
  reportsCount         Int          @default(0) @map("reports_count")
  verifiedReportsCount Int          @default(0) @map("verified_reports_count")
  isVerifiedUser       Boolean      @default(false) @map("is_verified_user")

  // Account status
  isBanned             Boolean      @default(false) @map("is_banned")
  banReason            String?      @map("ban_reason")
  bannedAt             DateTime?    @map("banned_at")
  bannedUntil          DateTime?    @map("banned_until")

  // Timestamps
  lastActiveAt         DateTime?    @map("last_active_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  // Relations
  devices            UserDevice[]
  settings           UserSettings?
  incidents          Incident[]        @relation("UserIncidents")
  verifiedIncidents  Incident[]        @relation("VerifiedByUser")
  media              IncidentMedia[]
  incidentUpdates    IncidentUpdate[]
  comments           Comment[]
  votes              Vote[]
  notifications      Notification[]
  refreshTokens      RefreshToken[]
  moderationAssigned ModerationQueue[] @relation("AssignedModerator")
  moderationDecided  ModerationQueue[] @relation("DecidedModerator")
  reportsFiled       UserReport[]      @relation("Reporter")
  reportsReceived    UserReport[]      @relation("ReportedUser")
  auditLogs          AuditLog[]
  reputationLogs     ReputationLog[]

  @@index([appleId])
  @@index([phoneNumber])
  @@index([email])
  @@index([username])
  @@index([role])
  @@index([reputationScore])
  @@index([createdAt])
  @@map("users")
}

model UserDevice {
  id               String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  deviceToken      String     @map("device_token")
  deviceType       DeviceType @map("device_type")
  deviceName       String?    @map("device_name") @db.VarChar(100)
  deviceModel      String?    @map("device_model") @db.VarChar(100)
  osVersion        String?    @map("os_version") @db.VarChar(50)
  appVersion       String?    @map("app_version") @db.VarChar(50)

  // APNs specific fields
  apnsToken        String?    @map("apns_token")
  apnsEnvironment  String?    @map("apns_environment") @db.VarChar(20) // 'production' or 'sandbox'

  isActive         Boolean    @default(true) @map("is_active")
  lastUsedAt       DateTime?  @map("last_used_at")
  createdAt        DateTime   @default(now()) @map("created_at")

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@unique([userId, deviceToken])
  @@index([userId])
  @@index([deviceToken])
  @@index([apnsToken])
  @@map("user_devices")
}

model UserSettings {
  id                    String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  notificationRadiusKm  Decimal  @default(5.0) @map("notification_radius_km") @db.Decimal(5, 2)
  notificationsEnabled  Boolean  @default(true) @map("notifications_enabled")
  notifyCategories      Json     @default("[]") @map("notify_categories")
  quietHoursStart       String?  @map("quiet_hours_start") @db.VarChar(5) // HH:MM format
  quietHoursEnd         String?  @map("quiet_hours_end") @db.VarChar(5)
  homeLocationLat       Decimal? @map("home_location_lat") @db.Decimal(10, 8)
  homeLocationLng       Decimal? @map("home_location_lng") @db.Decimal(11, 8)
  timezone              String?  @default("UTC") @db.VarChar(50)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Category {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name          String   @unique @db.VarChar(50)
  slug          String   @unique @db.VarChar(50)
  description   String?
  icon          String?  @db.VarChar(50)
  color         String?  @db.VarChar(7)
  severityLevel Int      @default(1) @map("severity_level")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  incidents Incident[]

  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

model Incident {
  id             String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  categoryId     String           @map("category_id") @db.Uuid
  title          String           @db.VarChar(200)
  description    String?

  // Geospatial fields (Google Maps format: lat/lng)
  latitude       Decimal          @db.Decimal(10, 8)
  longitude      Decimal          @db.Decimal(11, 8)
  // Note: We'll create a PostGIS geography column via raw SQL migration
  // for efficient spatial queries with GIST index

  // Location metadata
  address        String?
  city           String?          @db.VarChar(100)
  neighborhood   String?          @db.VarChar(100)
  postalCode     String?          @map("postal_code") @db.VarChar(20)
  country        String?          @default("US") @db.VarChar(2)

  // Status and severity
  status         IncidentStatus   @default(PENDING)
  severity       IncidentSeverity @default(MEDIUM)

  // Privacy
  isAnonymous    Boolean          @default(false) @map("is_anonymous")

  // Engagement metrics
  viewsCount     Int              @default(0) @map("views_count")
  upvotesCount   Int              @default(0) @map("upvotes_count")
  downvotesCount Int              @default(0) @map("downvotes_count")
  verifyCount    Int              @default(0) @map("verify_count")
  commentsCount  Int              @default(0) @map("comments_count")

  // Verification
  verificationThreshold Int       @default(3) @map("verification_threshold")
  verifiedAt     DateTime?        @map("verified_at")
  verifiedById   String?          @map("verified_by") @db.Uuid

  // Resolution
  resolvedAt     DateTime?        @map("resolved_at")
  resolutionNote String?          @map("resolution_note")

  // Expiration
  expiresAt      DateTime?        @map("expires_at")

  // Timestamps
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  // Relations
  user          User             @relation("UserIncidents", fields: [userId], references: [id])
  category      Category         @relation(fields: [categoryId], references: [id])
  verifiedBy    User?            @relation("VerifiedByUser", fields: [verifiedById], references: [id])
  media         IncidentMedia[]
  updates       IncidentUpdate[]
  comments      Comment[]
  votes         Vote[]
  notifications Notification[]

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@index([latitude, longitude])
  @@index([status, createdAt])
  @@index([expiresAt])
  @@map("incidents")
}

model IncidentMedia {
  id               String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  incidentId       String           @map("incident_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  mediaType        MediaType        @map("media_type")

  // S3/Storage URLs
  url              String
  thumbnailUrl     String?          @map("thumbnail_url")
  s3Key            String?          @map("s3_key")
  s3Bucket         String?          @map("s3_bucket")

  // File metadata
  fileName         String?          @map("file_name") @db.VarChar(255)
  mimeType         String?          @map("mime_type") @db.VarChar(100)
  fileSize         Int?             @map("file_size")

  // Video specific
  durationSeconds  Int?             @map("duration_seconds")
  width            Int?
  height           Int?

  // iOS specific metadata
  deviceModel      String?          @map("device_model") @db.VarChar(100)
  capturedAt       DateTime?        @map("captured_at")

  isPrimary        Boolean          @default(false) @map("is_primary")
  moderationStatus ModerationStatus @default(PENDING) @map("moderation_status")
  createdAt        DateTime         @default(now()) @map("created_at")

  // Relations
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([incidentId])
  @@index([userId])
  @@index([moderationStatus])
  @@map("incident_media")
}

model IncidentUpdate {
  id         String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  incidentId String     @map("incident_id") @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  updateType UpdateType @map("update_type")
  content    String
  metadata   Json?
  createdAt  DateTime   @default(now()) @map("created_at")

  // Relations
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([incidentId])
  @@index([createdAt])
  @@map("incident_updates")
}

model Comment {
  id               String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  incidentId       String           @map("incident_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  parentId         String?          @map("parent_id") @db.Uuid
  content          String
  isEdited         Boolean          @default(false) @map("is_edited")
  isDeleted        Boolean          @default(false) @map("is_deleted")
  upvotesCount     Int              @default(0) @map("upvotes_count")
  moderationStatus ModerationStatus @default(APPROVED) @map("moderation_status")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relations
  incident Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id])
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")
  votes    Vote[]

  @@index([incidentId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
  @@map("comments")
}

model Vote {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  incidentId String?  @map("incident_id") @db.Uuid
  commentId  String?  @map("comment_id") @db.Uuid
  voteType   VoteType @map("vote_type")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  comment  Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, incidentId])
  @@unique([userId, commentId])
  @@index([incidentId])
  @@index([commentId])
  @@map("votes")
}

model ReputationLog {
  id              String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  action          ReputationAction
  points          Int
  previousScore   Int              @map("previous_score")
  newScore        Int              @map("new_score")

  // Reference to related entity
  referenceType   String?          @map("reference_type") @db.VarChar(50)
  referenceId     String?          @map("reference_id") @db.Uuid

  description     String?
  metadata        Json?
  createdAt       DateTime         @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("reputation_logs")
}

model Notification {
  id         String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  incidentId String?          @map("incident_id") @db.Uuid
  type       NotificationType
  title      String           @db.VarChar(200)
  body       String?
  data       Json?

  // APNs specific
  apnsId     String?          @map("apns_id") @db.VarChar(100)
  apnsCategory String?        @map("apns_category") @db.VarChar(50) // e.g., "NEARBY_INCIDENT"

  // Delivery status
  isRead     Boolean          @default(false) @map("is_read")
  isSent     Boolean          @default(false) @map("is_sent")
  sentAt     DateTime?        @map("sent_at")
  readAt     DateTime?        @map("read_at")
  failReason String?          @map("fail_reason")

  createdAt  DateTime         @default(now()) @map("created_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([type])
  @@map("notifications")
}

model ModerationQueue {
  id            String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  contentType   ModerationContentType  @map("content_type")
  contentId     String                 @map("content_id") @db.Uuid
  reason        ModerationReason
  priority      Int                    @default(1)
  reportedById  String?                @map("reported_by") @db.Uuid
  reportReason  String?                @map("report_reason")
  assignedToId  String?                @map("assigned_to") @db.Uuid
  status        ModerationQueueStatus  @default(PENDING)
  decisionNotes String?                @map("decision_notes")
  decidedById   String?                @map("decided_by") @db.Uuid
  decidedAt     DateTime?              @map("decided_at")
  createdAt     DateTime               @default(now()) @map("created_at")

  // Relations
  assignedTo User? @relation("AssignedModerator", fields: [assignedToId], references: [id])
  decidedBy  User? @relation("DecidedModerator", fields: [decidedById], references: [id])

  @@index([status])
  @@index([contentType])
  @@index([priority])
  @@index([createdAt])
  @@map("moderation_queue")
}

model UserReport {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reporterId     String       @map("reporter_id") @db.Uuid
  reportedUserId String       @map("reported_user_id") @db.Uuid
  reason         ReportReason
  description    String?
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now()) @map("created_at")

  // Relations
  reporter     User @relation("Reporter", fields: [reporterId], references: [id])
  reportedUser User @relation("ReportedUser", fields: [reportedUserId], references: [id])

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@map("user_reports")
}

model AuditLog {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.Uuid
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  deviceId  String?   @map("device_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
