generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuidOssp(map: "uuid-ossp"), pgTrgm(map: "pg_trgm")]
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum DeviceType {
  IOS
  ANDROID
  WEB
}

enum IncidentStatus {
  PENDING
  VERIFIED
  RESOLVED
  REJECTED
  EXPIRED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ModerationContentType {
  INCIDENT
  COMMENT
  MEDIA
  USER
}

enum ModerationReason {
  NEW_CONTENT
  REPORTED
  AUTO_FLAGGED
  AI_FLAGGED
}

enum ModerationQueueStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum ReportReason {
  SPAM
  HARASSMENT
  FALSE_INFO
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  ACTION_TAKEN
  DISMISSED
}

enum VoteType {
  UPVOTE
  DOWNVOTE
  VERIFY
}

enum NotificationType {
  NEARBY_INCIDENT
  COMMENT
  UPDATE
  VERIFICATION
  SYSTEM
}

enum UpdateType {
  STATUS_CHANGE
  INFO_UPDATE
  RESOLUTION
}

// ============================================================================
// MODELS
// ============================================================================

model User {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  phoneNumber          String    @unique @map("phone_number") @db.VarChar(20)
  phoneVerified        Boolean   @default(false) @map("phone_verified")
  email                String?   @unique @db.VarChar(255)
  username             String?   @unique @db.VarChar(50)
  displayName          String?   @map("display_name") @db.VarChar(100)
  avatarUrl            String?   @map("avatar_url")
  passwordHash         String?   @map("password_hash") @db.VarChar(255)
  role                 UserRole  @default(USER)
  reputationScore      Int       @default(0) @map("reputation_score")
  reportsCount         Int       @default(0) @map("reports_count")
  verifiedReportsCount Int       @default(0) @map("verified_reports_count")
  isBanned             Boolean   @default(false) @map("is_banned")
  banReason            String?   @map("ban_reason")
  lastActiveAt         DateTime? @map("last_active_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  devices            UserDevice[]
  settings           UserSettings?
  incidents          Incident[]        @relation("UserIncidents")
  verifiedIncidents  Incident[]        @relation("VerifiedByUser")
  media              IncidentMedia[]
  incidentUpdates    IncidentUpdate[]
  comments           Comment[]
  votes              Vote[]
  notifications      Notification[]
  refreshTokens      RefreshToken[]
  moderationAssigned ModerationQueue[] @relation("AssignedModerator")
  moderationDecided  ModerationQueue[] @relation("DecidedModerator")
  reportsFiled       UserReport[]      @relation("Reporter")
  reportsReceived    UserReport[]      @relation("ReportedUser")
  auditLogs          AuditLog[]

  @@index([phoneNumber])
  @@index([email])
  @@index([username])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model UserDevice {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  deviceToken String     @map("device_token")
  deviceType  DeviceType @map("device_type")
  deviceName  String?    @map("device_name") @db.VarChar(100)
  isActive    Boolean    @default(true) @map("is_active")
  lastUsedAt  DateTime?  @map("last_used_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@unique([userId, deviceToken])
  @@index([userId])
  @@index([deviceToken])
  @@map("user_devices")
}

model UserSettings {
  id                    String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  notificationRadiusKm  Decimal  @default(5.0) @map("notification_radius_km") @db.Decimal(5, 2)
  notificationsEnabled  Boolean  @default(true) @map("notifications_enabled")
  notifyCategories      Json     @default("[]") @map("notify_categories")
  quietHoursStart       String?  @map("quiet_hours_start") @db.VarChar(5)
  quietHoursEnd         String?  @map("quiet_hours_end") @db.VarChar(5)
  homeLocationLat       Decimal? @map("home_location_lat") @db.Decimal(10, 8)
  homeLocationLng       Decimal? @map("home_location_lng") @db.Decimal(11, 8)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Category {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name          String   @unique @db.VarChar(50)
  slug          String   @unique @db.VarChar(50)
  description   String?
  icon          String?  @db.VarChar(50)
  color         String?  @db.VarChar(7)
  severityLevel Int      @default(1) @map("severity_level")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  incidents Incident[]

  @@index([slug])
  @@index([isActive])
  @@map("categories")
}

model Incident {
  id             String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  categoryId     String           @map("category_id") @db.Uuid
  title          String           @db.VarChar(200)
  description    String?
  latitude       Decimal          @db.Decimal(10, 8)
  longitude      Decimal          @db.Decimal(11, 8)
  address        String?
  city           String?          @db.VarChar(100)
  neighborhood   String?          @db.VarChar(100)
  status         IncidentStatus   @default(PENDING)
  severity       IncidentSeverity @default(MEDIUM)
  isAnonymous    Boolean          @default(false) @map("is_anonymous")
  viewsCount     Int              @default(0) @map("views_count")
  upvotesCount   Int              @default(0) @map("upvotes_count")
  commentsCount  Int              @default(0) @map("comments_count")
  expiresAt      DateTime?        @map("expires_at")
  verifiedAt     DateTime?        @map("verified_at")
  verifiedById   String?          @map("verified_by") @db.Uuid
  resolvedAt     DateTime?        @map("resolved_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  // Relations
  user       User             @relation("UserIncidents", fields: [userId], references: [id])
  category   Category         @relation(fields: [categoryId], references: [id])
  verifiedBy User?            @relation("VerifiedByUser", fields: [verifiedById], references: [id])
  media      IncidentMedia[]
  updates    IncidentUpdate[]
  comments   Comment[]
  votes      Vote[]
  notifications Notification[]

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@index([latitude, longitude])
  @@index([status, createdAt])
  @@map("incidents")
}

model IncidentMedia {
  id               String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  incidentId       String           @map("incident_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  mediaType        MediaType        @map("media_type")
  url              String
  thumbnailUrl     String?          @map("thumbnail_url")
  fileSize         Int?             @map("file_size")
  durationSeconds  Int?             @map("duration_seconds")
  isPrimary        Boolean          @default(false) @map("is_primary")
  moderationStatus ModerationStatus @default(PENDING) @map("moderation_status")
  createdAt        DateTime         @default(now()) @map("created_at")

  // Relations
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([incidentId])
  @@index([userId])
  @@index([moderationStatus])
  @@map("incident_media")
}

model IncidentUpdate {
  id         String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  incidentId String     @map("incident_id") @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  updateType UpdateType @map("update_type")
  content    String
  createdAt  DateTime   @default(now()) @map("created_at")

  // Relations
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([incidentId])
  @@index([createdAt])
  @@map("incident_updates")
}

model Comment {
  id               String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  incidentId       String           @map("incident_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  parentId         String?          @map("parent_id") @db.Uuid
  content          String
  isEdited         Boolean          @default(false) @map("is_edited")
  isDeleted        Boolean          @default(false) @map("is_deleted")
  upvotesCount     Int              @default(0) @map("upvotes_count")
  moderationStatus ModerationStatus @default(APPROVED) @map("moderation_status")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relations
  incident Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id])
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")
  votes    Vote[]

  @@index([incidentId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
  @@map("comments")
}

model Vote {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  incidentId String?  @map("incident_id") @db.Uuid
  commentId  String?  @map("comment_id") @db.Uuid
  voteType   VoteType @map("vote_type")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  comment  Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, incidentId])
  @@unique([userId, commentId])
  @@index([incidentId])
  @@index([commentId])
  @@map("votes")
}

model Notification {
  id         String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  incidentId String?          @map("incident_id") @db.Uuid
  type       NotificationType
  title      String           @db.VarChar(200)
  body       String?
  data       Json?
  isRead     Boolean          @default(false) @map("is_read")
  sentAt     DateTime?        @map("sent_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model ModerationQueue {
  id            String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  contentType   ModerationContentType  @map("content_type")
  contentId     String                 @map("content_id") @db.Uuid
  reason        ModerationReason
  priority      Int                    @default(1)
  reportedById  String?                @map("reported_by") @db.Uuid
  reportReason  String?                @map("report_reason")
  assignedToId  String?                @map("assigned_to") @db.Uuid
  status        ModerationQueueStatus  @default(PENDING)
  decisionNotes String?                @map("decision_notes")
  decidedById   String?                @map("decided_by") @db.Uuid
  decidedAt     DateTime?              @map("decided_at")
  createdAt     DateTime               @default(now()) @map("created_at")

  // Relations
  assignedTo User? @relation("AssignedModerator", fields: [assignedToId], references: [id])
  decidedBy  User? @relation("DecidedModerator", fields: [decidedById], references: [id])

  @@index([status])
  @@index([contentType])
  @@index([priority])
  @@index([createdAt])
  @@map("moderation_queue")
}

model UserReport {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reporterId     String       @map("reporter_id") @db.Uuid
  reportedUserId String       @map("reported_user_id") @db.Uuid
  reason         ReportReason
  description    String?
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now()) @map("created_at")

  // Relations
  reporter     User @relation("Reporter", fields: [reporterId], references: [id])
  reportedUser User @relation("ReportedUser", fields: [reportedUserId], references: [id])

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@map("user_reports")
}

model AuditLog {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.Uuid
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  deviceId  String?   @map("device_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
