# =============================================================================
# Khabar Backend Environment Configuration
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Database (PostgreSQL with PostGIS)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://khabar:khabar_secret@localhost:5432/khabar?schema=public"

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# -----------------------------------------------------------------------------
# Apple Sign-in Configuration (iOS)
# Get these from Apple Developer Portal -> Certificates, Identifiers & Profiles
# -----------------------------------------------------------------------------
APPLE_CLIENT_ID=com.yourcompany.khabar
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
# Paste your Apple private key here (replace newlines with \n)
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI=https://yourapp.com/auth/apple/callback

# -----------------------------------------------------------------------------
# APNs (Apple Push Notification service)
# Get these from Apple Developer Portal -> Keys
# -----------------------------------------------------------------------------
APNS_KEY_ID=YOUR_APNS_KEY_ID
APNS_TEAM_ID=YOUR_TEAM_ID
# Paste your APNs private key here (replace newlines with \n)
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
APNS_BUNDLE_ID=com.yourcompany.khabar

# -----------------------------------------------------------------------------
# AWS S3 / MinIO Configuration
# For local development, use MinIO. For production, use AWS S3.
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=khabar-media
S3_PUBLIC_URL=http://localhost:9000/khabar-media

# -----------------------------------------------------------------------------
# Geospatial Settings
# -----------------------------------------------------------------------------
DEFAULT_SEARCH_RADIUS_KM=5
MAX_SEARCH_RADIUS_KM=50

# -----------------------------------------------------------------------------
# Media Upload Settings
# -----------------------------------------------------------------------------
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=60

# -----------------------------------------------------------------------------
# Incident Settings
# -----------------------------------------------------------------------------
INCIDENT_EXPIRY_HOURS=24
VERIFICATION_THRESHOLD=3

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed origins
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# -----------------------------------------------------------------------------
# Reputation System Points
# -----------------------------------------------------------------------------
REPUTATION_INCIDENT_CREATED=5
REPUTATION_INCIDENT_VERIFIED=20
REPUTATION_INCIDENT_REJECTED=-10
REPUTATION_UPVOTE_RECEIVED=2
REPUTATION_DOWNVOTE_RECEIVED=-1
REPUTATION_VERIFY_RECEIVED=5
REPUTATION_COMMENT_UPVOTED=1
REPUTATION_REPORT_ACCEPTED=-25
REPUTATION_REPORT_REJECTED=5
REPUTATION_BAN_PENALTY=-100

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
